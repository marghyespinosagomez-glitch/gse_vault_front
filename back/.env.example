# Puerto en el que corre el servidor Express
PORT=3000

# Secreto y expiracion para la firma de JWT
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=1h

# Servicio externo de gestion de clientes (el front no lo llama directo por CORS, pasa por este proxy)
EXTERNAL_CLIENTS_BASE_URL=http://127.0.0.1:3073/logic
